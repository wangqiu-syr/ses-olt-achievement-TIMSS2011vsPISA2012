// Design and procedure of the A2 analysis and its exploratory 96-run grid.
// Render from the repository root:
//   dot -Tpng -Gdpi=200 docs/figures/design_flowchart.dot -o docs/figures/design_flowchart.png
//   dot -Tsvg           docs/figures/design_flowchart.dot -o docs/figures/design_flowchart.svg
digraph design {
  graph [rankdir=TB, fontname="Inter", fontsize=11, bgcolor="#fcfcfb", nodesep=0.35, ranksep=0.42,
         pad=0.3, newrank=true, compound=true, labeljust=l];
  node  [shape=box, style="rounded,filled", fontname="Inter", fontsize=10, color="#2a78d6",
         fillcolor="#eef4fc", fontcolor="#0b0b0b", penwidth=1.1, margin="0.16,0.08"];
  edge  [color="#52514e", arrowsize=0.7, penwidth=1.0, fontname="Inter", fontsize=9, fontcolor="#52514e"];

  // ---------------------------------------------------------------- 1. data
  subgraph cluster_data {
    label=<<B>1  Data preparation</B>  <FONT COLOR="#52514e">R/a2_01_prepare_pisa2012.R</FONT>>;
    style="rounded,filled"; color="#d9d8d3"; fillcolor="#f6f5f2"; fontcolor="#0b0b0b"; margin=12;
    raw    [shape=cylinder, fillcolor="#ffffff", color="#52514e",
            label=<<B>PISA 2012, United States</B><BR/>student + school questionnaire extract<BR/>4,978 students · 162 schools>];
    prep   [label=<<B>Aggregate students to schools</B> (weighted means, W_FSTUWT)<BR ALIGN="LEFT"/>SES composite (books, parental education, home possessions) · ESCS<BR ALIGN="LEFT"/>OTL: FAMCONC · OTL_PT (ST73–76) · EXPUREM · EXAPPLM<BR ALIGN="LEFT"/>ICT use (SC13) · ICT resources (SC14)<BR ALIGN="LEFT"/>6 outcomes × 5 plausible values<BR ALIGN="LEFT"/>>];
    checks [label=<<B>Data checks D1–D5</B><BR/>sample sizes · weighted means vs. OECD · r(SES, ESCS)>];
    files  [label=<<B>School files</B><BR/>Model 1: 146 schools · Model 2: 139 schools>];
    raw -> prep -> checks -> files;
  }

  // ---------------------------------------------------------------- 2. validation
  subgraph cluster_valid {
    label=<<B>2  Check the R pipeline against SmartPLS</B>>;
    style="rounded,filled"; color="#d9d8d3"; fillcolor="#f6f5f2"; fontcolor="#0b0b0b"; margin=12;
    smartpls [label=<<B>SmartPLS 4</B> (by hand)<BR/>math · print reading · science<BR/>× Model 1/2 × SES/ESCS = 12 runs>];
    readsp   [label=<<B>Read exports, criteria M1–M4</B><BR/><FONT COLOR="#52514e">R/a2_02_read_smartpls.R</FONT>>];
    cross    [label=<<B>seminr re-estimates the 12 runs</B><BR/>estimates within .0003 · same verdicts<BR/><FONT COLOR="#52514e">R/a2_04_seminr_crosscheck.R</FONT>>];
    smartpls -> readsp -> cross;
  }

  // ---------------------------------------------------------------- model (inset)
  subgraph cluster_model {
    label=<<B>Structural model</B>  <FONT COLOR="#52514e">(spec §4)</FONT>>;
    style="rounded,filled"; color="#d9d8d3"; fillcolor="#ffffff"; fontcolor="#0b0b0b"; margin=10;
    node [shape=ellipse, style="filled", fillcolor="#eef4fc", color="#2a78d6", margin="0.06,0.03", fontsize=9];
    mSES [label="SES"]; mICT [label="ICT"]; mOTL [label="OTL"]; mACH [label="Achievement"];
    mINT [label="SES × ICT", shape=diamond, fillcolor="#fdf1ec", color="#eb6834"];
    // invisible anchor fixes the left-to-right order SES, SES × ICT, ICT
    mAnc [shape=point, style=invis, width=0, height=0, label="", ordering=out];
    mAnc -> mSES [style=invis]; mAnc -> mINT [style=invis]; mAnc -> mICT [style=invis];
    mSES -> mOTL; mICT -> mOTL; mSES -> mACH; mICT -> mACH; mOTL -> mACH;
    mINT -> mACH [color="#eb6834", penwidth=1.4];
    {rank=same; mSES; mINT; mICT}
  }

  // ---------------------------------------------------------------- 3. grid
  subgraph cluster_grid {
    label=<<B>3  Exploratory grid: 96 runs</B>  <FONT COLOR="#52514e">R/a2_05_seminr_runs.R</FONT>>;
    style="rounded,filled"; color="#eb6834"; fillcolor="#fdf6f2"; fontcolor="#0b0b0b"; margin=12; penwidth=1.3;
    factors [shape=plain, style="", label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#d9d8d3" BGCOLOR="#ffffff">
        <TR><TD ALIGN="LEFT"><B>Factor</B></TD><TD ALIGN="LEFT"><B>Levels</B></TD><TD><B>n</B></TD></TR>
        <TR><TD ALIGN="LEFT">Outcome</TD><TD ALIGN="LEFT">paper: math · print reading · science<BR ALIGN="LEFT"/>computer: digital reading · computer-based math · problem solving<BR ALIGN="LEFT"/></TD><TD>6</TD></TR>
        <TR><TD ALIGN="LEFT">OTL measure</TD><TD ALIGN="LEFT">FAMCONC (spec) · OTL_PT · EXPUREM · EXAPPLM</TD><TD>4</TD></TR>
        <TR><TD ALIGN="LEFT">ICT model</TD><TD ALIGN="LEFT">Model 1: ICT use · Model 2: ICT resources</TD><TD>2</TD></TR>
        <TR><TD ALIGN="LEFT">SES measure</TD><TD ALIGN="LEFT">SES composite (primary) · ESCS (sensitivity)</TD><TD>2</TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#fdf1ec"><B>Runs</B></TD><TD ALIGN="LEFT" BGCOLOR="#fdf1ec">6 × 4 × 2 × 2</TD><TD BGCOLOR="#fdf1ec"><B>96</B></TD></TR>
      </TABLE>>];
    est  [label=<<B>Each run</B><BR/>PLS-SEM: mode A, path weighting<BR/>two-stage SES × ICT interaction<BR/>5,000-sample percentile bootstrap>];
    crit [label=<<B>Criteria M1–M4 per run</B><BR/>loadings · α / ρ<SUB>C</SUB> / AVE · HTMT, Fornell–Larcker · inner VIF>];
    factors -> est -> crit;
  }

  // ---------------------------------------------------------------- 4. report
  subgraph cluster_report {
    label=<<B>4  Report</B>>;
    style="rounded,filled"; color="#d9d8d3"; fillcolor="#f6f5f2"; fontcolor="#0b0b0b"; margin=12;
    outs [label=<<B>Estimates and criteria</B><BR/>estimates.csv · criteria.csv · summary.md>];
    rule [shape=note, fillcolor="#ffffff", color="#52514e",
          label=<<B>Decision rule</B><BR/>a result is a pattern only if it holds<BR/>across OTL measures <I>and</I> with ESCS;<BR/>a single significant cell is a lead>];
    figs [label=<<B>Figures</B>: moderation across the grid · simple slopes<BR/>robustness · OTL by measure<BR/><FONT COLOR="#52514e">R/a2_06_moderation_figures.R</FONT>>];
    rep  [label=<<B>Moderation report</B> with literature<BR/><FONT COLOR="#52514e">results/a2_seminr/moderation_report.md</FONT>>];
    outs -> figs -> rep;
    rule -> rep [style=dashed];
  }

  // ---------------------------------------------------------------- links between stages
  files -> smartpls [lhead=cluster_valid];
  files -> factors  [lhead=cluster_grid];
  cross -> est      [label="  validated\n  settings", style=dashed];
  mACH  -> est      [ltail=cluster_model, style=dashed, arrowhead=none, color="#a9a8a3"];
  crit  -> outs;
}
